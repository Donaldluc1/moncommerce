# backend/.env.example — copier vers .env et remplir avec les vraies valeurs
# Ne JAMAIS commiter le .env réel.

DATABASE_URL="postgresql://user:password@localhost:5432/gestion_commerce"
JWT_SECRET="changez_moi_secret_aleatoire_long"
PORT=3000
NODE_ENV=development

# ============================
# IA / COMMANDE VOCALE
# ============================

# Moteur IA par défaut : claude | chatgpt | deepseek
# (peut être surchargé requête par requête via le champ "provider")
AI_PROVIDER="claude"

# Claude (Anthropic) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-xxxxx"
# Modèle Claude : CLAUDE_MODEL est prioritaire, AI_MODEL conservé pour compatibilité
AI_MODEL="claude-opus-5"
# CLAUDE_MODEL="claude-opus-5"

# ChatGPT (OpenAI) — https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=""
# DEEPSEEK_MODEL="deepseek-chat"
